{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@eihrteam/xml",
  "version": "0.4.2-rc.1",
  "description": "Convert SKLand Endfield Wiki public item JSON and XML locally.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@10.33.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EIHRTeam/xml.git"
  },
  "bugs": {
    "url": "https://github.com/EIHRTeam/xml/issues"
  },
  "homepage": "https://github.com/EIHRTeam/xml#readme",
  "keywords": [
    "skland",
    "endfield",
    "wiki",
    "xml",
    "json"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "xml": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm check",
    "build": "tsup src/index.ts src/cli.ts --format esm --clean --target node20 --minify && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pack:dry-run": "pnpm build && pnpm pack --dry-run",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20"
  }
}
