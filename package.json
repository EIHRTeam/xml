{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@eihrteam/xml",
  "version": "0.6.0",
  "description": "Convert SKLand Endfield Wiki public item JSON and XML locally.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EIHRTeam/xml.git"
  },
  "bugs": {
    "url": "https://github.com/EIHRTeam/xml/issues"
  },
  "homepage": "https://github.com/EIHRTeam/xml#readme",
  "keywords": [
    "skland",
    "endfield",
    "wiki",
    "xml",
    "json"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "xml": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm check",
    "build": "tsdown && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pack:dry-run": "pnpm build && pnpm pack --dry-run",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  }
}
